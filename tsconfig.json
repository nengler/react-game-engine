{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/compiler/src",
    "packages/compiler/test",
    "packages/runtime/src",
    "packages/runtime/test",
    "packages/player/src",
    "packages/player/test",
    "packages/player/bench",
    "tools",
    "packages/player-node/src",
    "packages/player-node/test",
    "packages/native/src",
    "packages/native/test",
    "packages/cli/src",
    "packages/language-server/src",
    "packages/language-server/test",
    "packages/testing/src",
    "packages/testing/test",
    "packages/cli/test",
    "games/demo/generated",
    "games/demo/game.ts",
    "games/demo/parity.ts",
    "games/demo/main.ts",
    "games/demo/tools",
    "games/demo/test",
    "packages/example/generated",
    "games/kite/generated",
    "games/kite/game.ts",
    "games/kite/main.ts","games/kite/parity.ts",
    "games/kite/src/rules",
    "games/kite/src/GameState.ts",
    "games/kite/tools",
    "games/kite/test"
  ]
}
