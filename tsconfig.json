{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/compiler/src",
    "packages/compiler/test",
    "packages/runtime/src",
    "packages/runtime/test",
    "packages/player/src",
    "packages/player/test",
    "packages/player/bench",
    "tools",
    "packages/player-node/src",
    "packages/player-node/test",
    "packages/demo/generated",
    "packages/demo/game.ts",
    "packages/demo/parity.ts",
    "packages/demo/main.ts",
    "packages/demo/tools",
    "packages/demo/test",
    "packages/example/generated",
    "packages/kite/generated",
    "packages/kite/game.ts",
    "packages/kite/main.ts","packages/kite/parity.ts",
    "packages/kite/src/rules",
    "packages/kite/src/GameState.ts",
    "packages/kite/tools",
    "packages/kite/test"
  ]
}
