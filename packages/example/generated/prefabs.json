{
  "version": 1,
  "prefabs": {
    "Banner": {
      "module": "packages/example/src/Banner.tsx",
      "props": [
        {
          "name": "text",
          "type": {
            "kind": "Primitive",
            "name": "string"
          },
          "optional": false,
          "settable": true
        }
      ]
    },
    "Coin": {
      "module": "packages/example/src/Coin.tsx",
      "props": [
        {
          "name": "value",
          "type": {
            "kind": "Primitive",
            "name": "number"
          },
          "optional": false,
          "settable": true
        },
        {
          "name": "spin",
          "type": {
            "kind": "Primitive",
            "name": "number"
          },
          "optional": true,
          "settable": true,
          "default": 1
        }
      ]
    },
    "Enemy": {
      "module": "packages/example/src/Level.tsx",
      "props": [
        {
          "name": "speed",
          "type": {
            "kind": "Primitive",
            "name": "number"
          },
          "optional": false,
          "settable": true
        },
        {
          "name": "tint",
          "type": {
            "kind": "Literals",
            "values": [
              "red",
              "blue"
            ]
          },
          "optional": true,
          "settable": true,
          "default": "red"
        }
      ]
    },
    "Panel": {
      "module": "packages/example/src/Panel.tsx",
      "props": [
        {
          "name": "title",
          "type": {
            "kind": "Primitive",
            "name": "string"
          },
          "optional": false,
          "settable": true
        }
      ]
    },
    "Trail": {
      "module": "packages/example/src/Coin.tsx",
      "props": [
        {
          "name": "value",
          "type": {
            "kind": "Primitive",
            "name": "number"
          },
          "optional": false,
          "settable": true
        }
      ]
    },
    "WarningIcon": {
      "module": "packages/example/src/WarningIcon.tsx",
      "props": []
    }
  }
}
