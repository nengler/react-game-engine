{
  "name": "tse",
  "displayName": "tse",
  "description": "TSE diagnostics and quick fixes for tse components, as you type.",
  "version": "0.0.1",
  "publisher": "tse",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Linters"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:typescriptreact", "onLanguage:typescript"],
  "contributes": {
    "configuration": {
      "title": "tse",
      "properties": {
        "tse.node": {
          "type": "string",
          "default": "node",
          "description": "The Node.js (22.6 or later) that runs the game's `tse lsp`."
        }
      }
    },
    "commands": [
      {
        "command": "tse.restart",
        "title": "tse: Restart the language server"
      }
    ]
  }
}
