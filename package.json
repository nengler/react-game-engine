{
  "name": "react-game-engine",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "generate": "npm run -s demo && npm run -s example && npm run -s kite && npm run -s hearth",
    "pretest": "npm run -s generate",
    "pretypecheck": "npm run -s generate",
    "test": "node --test \"packages/*/test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/example/tsconfig.json && tsc -p packages/demo/tsconfig.json && tsc -p packages/kite/tsconfig.json && tsc -p packages/hearth/tsconfig.json",
    "native:build": "cmake -S native -B native/build && cmake --build native/build -j",
    "native:build:headless": "cmake -S native -B native/build-headless -DRGE_PLATFORM=Memory && cmake --build native/build-headless -j",
    "native:test": "cmake --build native/build-headless -j && ctest --test-dir native/build-headless --output-on-failure",
    "screenshot": "rge screenshot",
    "check:demo": "rge check packages/demo && tsc -p tsconfig.json",
    "bundle": "node tools/bundle.ts",
    "bench:check": "node tools/bench-check.ts",
    "pack": "node tools/pack.ts",
    "package": "rge package packages/demo",
    "host:build": "cargo build --release --manifest-path host/Cargo.toml",
    "host:build:headless": "cargo build --release --features headless --manifest-path host/Cargo.toml",
    "demo": "node packages/compiler/src/cli.ts packages/demo/src packages/demo/generated",
    "demo:assets": "node packages/demo/tools/make-assets.ts",
    "play:demo": "rge dev packages/demo",
    "kite": "node packages/compiler/src/cli.ts packages/kite/src packages/kite/generated --scenes packages/kite/scenes --assets packages/kite/assets",
    "kite:assets": "node packages/kite/tools/make-assets.ts",
    "kite:rooms": "node packages/kite/tools/make-rooms.ts",
    "kite:solve": "node packages/kite/tools/solve.ts --write",
    "play:kite": "rge dev packages/kite",
    "package:kite": "rge package packages/kite",
    "check:kite": "rge check packages/kite && tsc -p tsconfig.json",
    "example": "node packages/compiler/src/cli.ts packages/example/src packages/example/generated --scenes packages/example/scenes",
    "hearth": "node packages/compiler/src/cli.ts packages/hearth/src packages/hearth/generated --scenes packages/hearth/scenes --assets packages/hearth/assets",
    "hearth:assets": "node packages/hearth/tools/make-assets.ts",
    "hearth:map": "node packages/hearth/tools/make-map.ts",
    "play:hearth": "rge dev packages/hearth",
    "package:hearth": "rge package packages/hearth",
    "check:hearth": "rge check packages/hearth && tsc -p tsconfig.json",
    "native:build:pack": "node tools/pack.ts --build",
    "bramble:install": "node tools/bramble-install.ts",
    "check:outside": "node tools/check-outside.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "7.1.0-beta"
  }
}
