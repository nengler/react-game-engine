{
  "name": "tse",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/demo",
    "games/kite",
    "games/hearth",
    "games/swarm"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "generate": "npm run -s demo && npm run -s example && npm run -s kite && npm run -s hearth && npm run -s swarm",
    "pretest": "npm run -s generate",
    "pretypecheck": "npm run -s generate",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"games/{demo,kite,hearth,swarm}/test/**/*.test.ts\"",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/player-web/tsconfig.json && tsc -p packages/example/tsconfig.json && tsc -p games/demo/tsconfig.json && tsc -p games/kite/tsconfig.json && tsc -p games/hearth/tsconfig.json && tsc -p games/swarm/tsconfig.json",
    "native:build": "cmake -S native -B native/build && cmake --build native/build -j",
    "native:build:headless": "cmake -S native -B native/build-headless -DTSE_PLATFORM=Memory && cmake --build native/build-headless -j",
    "native:test": "cmake --build native/build-headless -j && ctest --test-dir native/build-headless --output-on-failure",
    "screenshot": "tse screenshot",
    "check:gpu": "node packages/cli/src/cli.ts screenshot games/demo --gpu --script \"right*20, _*10\" --at 9,29 --out /tmp/tse-gpu-demo --compare games/demo/test/gpu --tolerance 64 && node packages/cli/src/cli.ts screenshot games/kite --gpu --script \"_*5, Enter, _*40, right*20\" --at 3,65 --out /tmp/tse-gpu-kite --compare games/kite/test/gpu --tolerance 64",
    "check:demo": "tse check games/demo && tsc -p tsconfig.json",
    "bundle": "node tools/bundle.ts",
    "bench:check": "node tools/bench-check.ts",
    "ci:local": "node tools/ci-local.ts",
    "docs:index": "node tools/docs-index.ts",
    "pack": "node tools/pack.ts",
    "dist": "node tools/pack.ts --build",
    "package": "tse package games/demo",
    "host:build": "cargo build --release --manifest-path host/Cargo.toml",
    "host:build:headless": "cargo build --release --features headless --manifest-path host/Cargo.toml",
    "demo": "node packages/compiler/src/cli.ts games/demo/src games/demo/generated",
    "demo:assets": "node games/demo/tools/make-assets.ts",
    "play:demo": "tse dev games/demo",
    "kite": "node packages/compiler/src/cli.ts games/kite/src games/kite/generated --scenes games/kite/scenes --assets games/kite/assets",
    "kite:assets": "node games/kite/tools/make-assets.ts",
    "kite:rooms": "node games/kite/tools/make-rooms.ts",
    "kite:solve": "node games/kite/tools/solve.ts --write",
    "play:kite": "tse dev games/kite",
    "package:kite": "tse package games/kite",
    "check:kite": "tse check games/kite && tsc -p tsconfig.json",
    "example": "node packages/compiler/src/cli.ts packages/example/src packages/example/generated --scenes packages/example/scenes",
    "hearth": "node packages/compiler/src/cli.ts games/hearth/src games/hearth/generated --scenes games/hearth/scenes --assets games/hearth/assets",
    "hearth:assets": "node games/hearth/tools/make-assets.ts",
    "hearth:map": "node games/hearth/tools/make-map.ts",
    "play:hearth": "tse dev games/hearth",
    "package:hearth": "tse package games/hearth",
    "check:hearth": "tse check games/hearth && tsc -p tsconfig.json",
    "swarm": "node packages/compiler/src/cli.ts games/swarm/src games/swarm/generated --assets games/swarm/assets",
    "swarm:assets": "node games/swarm/tools/make-assets.ts",
    "play:swarm": "tse dev games/swarm",
    "check:swarm": "tse check games/swarm && tsc -p games/swarm/tsconfig.json",
    "native:build:pack": "node tools/pack.ts --build",
    "bramble:install": "node tools/bramble-install.ts",
    "check:outside": "node tools/check-outside.ts",
    "vscode:pack": "node tools/pack-vscode.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "7.1.0-beta"
  }
}
